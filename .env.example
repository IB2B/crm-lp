# Copy this file to .env.local and fill in the values. Never commit .env.local.
# In production, set the same variables in your host's settings (e.g. Vercel → Settings → Environment Variables).
# These are server-only: never add a NEXT_PUBLIC_ prefix, or Next.js would send them to the browser.

# GoHighLevel Private Integration token (Settings → Private Integrations in the sub-account).
# Scopes needed: contacts.write (newsletter + booking), calendars.readonly, calendars/events.write,
# locations/customFields.readonly (booking).
GHL_PRIVATE_TOKEN=

# GoHighLevel sub-account (location) ID.
# Used by /api/newsletter (footer newsletter, hidden until the token and this ID are set)
# and by the booking page (/[lang]/book → /api/booking).
GHL_LOCATION_ID=

# The GoHighLevel calendar the booking page reads free slots from and books 30-minute calls on.
GHL_CALENDAR_ID=G0rSuqw8F7nD13Jn91DH

# Optional: ID of the "plan_interest" contact custom field. If empty, the booking API looks it up by key
# (needs the locations/customFields.readonly scope). If neither works, bookings still go through and the
# plan is saved only as a "plan-…" tag.
# GHL_PLAN_FIELD_ID=

# Optional: the public site address used for canonical links and share images.
# Defaults to https://crm.intelligentb2b.com.
# NEXT_PUBLIC_SITE_URL=
