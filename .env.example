# Copy this file to .env.local and fill in the values. Never commit .env.local.
# In production, set the same variables in your host's settings (e.g. Vercel → Settings → Environment Variables).

# GoHighLevel private integration token and sub-account (location) ID.
# Used only on the server by /api/newsletter to add footer newsletter signups as tagged contacts.
# The newsletter form is hidden until both are set.
GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=
